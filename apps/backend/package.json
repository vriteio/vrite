{
  "name": "@andesine/backend",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "db:generate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs migrate --config drizzle.config.ts",
    "db:studio": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs studio --config drizzle.config.ts",
    "migrate": "node ./dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "dev": "tsx watch ./src/index.ts"
  },
  "dependencies": {
    "@andesine/editor": "workspace:*",
    "@andesine/templates": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@hocuspocus/extension-database": "^4.4.0",
    "@hocuspocus/extension-redis": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "@orpc/openapi": "^1.14.14",
    "@orpc/server": "^1.14.14",
    "@orpc/zod": "^1.14.14",
    "base-x": "^5.0.1",
    "better-auth": "^1.6.25",
    "bullmq": "^6.3.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "lexorank": "^1.0.5",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "rolldown": "^1.2.2",
    "tsx": "^4.23.5",
    "typescript": "6.0.3"
  }
}
