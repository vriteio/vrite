{
  "name": "@andesine/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/server/index.ts",
    "build": "pnpm build:client && pnpm build:server && pnpm build:runtime",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build:runtime": "rolldown -c rolldown.config.mjs",
    "start": "NODE_ENV=production node ./dist/server/index.js"
  },
  "dependencies": {
    "@andesine/components": "workspace:*",
    "@andesine/editor": "workspace:*",
    "@ark-ui/solid": "^5.36.2",
    "@atlaskit/pragmatic-drag-and-drop": "1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "2.0.15",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "1.1.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "1.3.4",
    "@better-auth/passkey": "^1.6.11",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@iconify/json": "^2.2.479",
    "@orpc/client": "^1.14.3",
    "@orpc/openapi-client": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@signaldb/core": "^1.8.1",
    "@signaldb/solid": "^1.0.0",
    "@signaldb/sync": "^1.3.1",
    "@solid-primitives/connectivity": "^0.4.5",
    "@solid-primitives/lifecycle": "^0.1.2",
    "@solid-primitives/refs": "^1.1.3",
    "@solid-primitives/resize-observer": "^2.1.5",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/transition-group": "^1.1.2",
    "@solidjs/router": "^0.16.1",
    "@tanstack/solid-query": "^5.101.2",
    "base-x": "^5.0.1",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "fastify": "^5.8.5",
    "idb": "^8.0.3",
    "lexorank": "^1.0.5",
    "motion": "^12.40.0",
    "solid-js": "^1.9.13",
    "srvx": "^0.11.15",
    "tinykeys": "^4.0.0",
