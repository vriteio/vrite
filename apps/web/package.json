    "mini-svg-data-uri": "^1.4.4",
    "rolldown": "^1.0.3",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.22.3",
    "unocss": "^66.7.0",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
