    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "3.0.3",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@atlaskit/pragmatic-drag-and-drop-live-region": "2.0.0",
    "@better-auth/passkey": "^1.6.25",
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^10.1.2",
    "@iconify/json": "^2.2.509",
    "@orpc/client": "^1.14.14",
    "@orpc/openapi-client": "^1.14.14",
    "@orpc/server": "^1.14.14",
    "@signaldb/core": "^1.8.1",
    "@signaldb/solid": "^1.0.0",
    "@signaldb/sync": "^1.3.1",
    "@solid-primitives/connectivity": "^0.4.6",
    "@solid-primitives/lifecycle": "^0.1.2",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.101.4",
    "base-x": "^5.0.1",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.11.2",
    "idb": "^8.0.3",
    "lexorank": "^1.0.5",
    "solid-js": "^1.9.14",
    "srvx": "^0.12.5",
